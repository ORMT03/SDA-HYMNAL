/* Small bounded JSON reader used by the native Kindle interface. No external runtime. */
typedef struct { int start, end, next, count; char type; } JT;
typedef struct { const char *s; size_t len, pos; JT *t; int used, cap, error; } JSON;
static void jspace(JSON *j) { while (j->pos < j->len && strchr(" \r\n\t", j->s[j->pos])) j->pos++; }
