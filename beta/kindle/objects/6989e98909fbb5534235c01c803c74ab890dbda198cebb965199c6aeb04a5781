            if unique:sections.append((catalogs[cid],unique))
        def output(song,**extra):return dict(number=song['number'],id=song.get('id',song['number']),title=song['title'],language=song['language'],collection=song.get('collection','sda'),**extra)
        ordered=[];grouped=bool(query and language=='both')
        if not query:
            for collection,rows in sections:
                for index,(song,_) in enumerate(rows):ordered.append(output(song,**({'collection_heading':collection['name']} if index==0 else {})))
        else:
            entries={identity(s):(s,a,c) for c,rows in sections for s,a in rows};ranked=[]
            for song,anchor,collection in entries.values():
                title=normalize(song['title']);code=normalize(song['number']);lyrics=normalize(song.get('content','')) if smart else '';rank=0
                if code==query or (query.isdigit() and (code==query.zfill(3) or code=='gyc'+query)):rank=200
                elif query in title:rank=100
                if smart:rank+=(40 if query in lyrics else 0)+sum((20 if w in title else 0)+(4 if w in lyrics else 0) for w in query.split())
                if query in normalize(collection['name']):rank+=20
                if anchor and (query in normalize(anchor['title']) or query==anchor['number']):rank+=30
                if rank:ranked.append((rank,song))
            ranked.sort(key=lambda row:(-row[0],row[1]['language'],row[1]['number']));seen=set()
            for _,song in ranked:
                if identity(song) in seen:continue
                peers=[song]+([loaded[identity(p)] for p in related(identity(song)) if p['language']!=song['language'] and identity(p) in entries] if grouped else [])
                for index,peer in enumerate(peers):
                    ordered.append(output(peer,group_start=index==0));seen.add(identity(peer))
        return dict(songs=ordered,count=len(ordered),settings=settings,grouped=grouped)

    def obtain_content(self, path):
        entry = self.entry(path, available=True) or self.entry(path)
        if not entry: raise ValueError('No score file is available for this hymn.')
        if self.have(entry): return self.blob_path(entry)
        try:
            data = self.fetch(entry['url'], maximum=entry['bytes'])
            if hashlib.sha256(data).hexdigest() != entry['sha256']: raise ValueError('Newer file on server')
        except Exception:
            archive = self.current.get('data', {}).get('archive')
            if not archive: raise
            zipped = self.fetch(archive['url'], maximum=archive['bytes'], timeout=120)
            if hashlib.sha256(zipped).hexdigest() != archive['sha256']: raise ValueError('Archive verification failed')
            with zipfile.ZipFile(io.BytesIO(zipped)) as source: data = source.read('files/' + entry['sha256'])
        # A viewed online score may be reused; selection cleanup can remove it later.
        self.put_blob(entry, data)
        return self.blob_path(entry)

