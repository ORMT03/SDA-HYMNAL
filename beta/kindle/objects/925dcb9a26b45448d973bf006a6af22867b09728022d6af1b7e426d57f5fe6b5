static int initial_root(InitialNode *nodes, int i) {
    int root = i;
    while (nodes[root].parent != root)
        root = nodes[root].parent;
    while (nodes[i].parent != i) {
        int next = nodes[i].parent;
        nodes[i].parent = root;
        i = next;
    }
    return root;
}
static void initial_join(InitialNode *nodes, int a, int b) {
    if (a >= 0 && b >= 0)
