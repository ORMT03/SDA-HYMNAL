                       '--font', 'Bravura', '--header', 'none', '--footer', 'none', '--breaks', 'encoded',
                       '--page-width', '2159', '--page-height', '2794', '--page-margin-top', '230',
                       '--page-margin-bottom', '100', '--page-margin-left', '65', '--page-margin-right', '65',
                       '--min-last-justification', '0', '--scale', '50', '--transpose', str(offset) if offset else 'P1', '-o', str(prefix), str(sanitized)]
            self.progress('Engraving the score on your Kindle…', 15)
            completed = subprocess.run(command, preexec_fn=render_limits, stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=120)
            (folder / 'engraving.log').write_bytes(completed.stderr)
            if completed.returncode: raise ValueError('The score could not be engraved. ' + completed.stderr.decode('utf-8', 'replace')[-250:])
            svgs = sorted(folder.glob('engraved*.svg'))
            if not svgs: raise ValueError('The engraving engine produced no pages.')
            koreader = Path(self.config.get('koreader_dir', '/mnt/us/koreader'))
            for index, svg in enumerate(svgs):
                png = svg.with_suffix('.png')
                completed = subprocess.run([str(koreader/'luajit'), str(self.app_dir/'svg_to_png.lua'),
                                            str(svg), str(png), '1275', '1650'], cwd=str(koreader),
                                           stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=90, preexec_fn=render_limits)
                if completed.returncode or not png.is_file():
                    raise ValueError('The native image renderer could not display this score: ' + completed.stderr.decode('utf-8','replace')[-250:])
                with Image.open(str(png)) as im:
                    white = Image.new('RGB', (1275, 1650), 'white'); converted = im.convert('RGBA').resize((1275,1650), Image.Resampling.LANCZOS if hasattr(Image,'Resampling') else Image.LANCZOS)
                    white.paste(converted, (0, 0), converted)
                    self._draw_metadata(white, metadata, song, options, index == 0, index == len(svgs)-1)
                    white.save(str(png)); white.close()
                pngs.append(png)
                self.progress('Preparing page ' + str(index+1) + '…', 40+int(40*(index+1)/len(svgs)))
        else:
            # Images are fetched only for a requested hymn, never by offline downloads.
            count = max(1, int(song.get('pages', 1))); name = song['image']; base = name.rsplit('.',1)[0].replace('_Full','')
            names = [name] if count == 1 else [base+('_'+str(i) if i else '')+'.png' for i in range(count)]
            for index, name in enumerate(names):
                url = urllib.parse.urljoin(self.base, 'src/Hymnal.XF/Resources/Assets/MusicSheets/'+urllib.parse.quote(name))
                data = self.fetch(url, maximum=16000000, timeout=45)
                source_png=folder/('download-'+str(index)+'.png');source_png.write_bytes(data);del data
                scaled=folder/('scaled-'+str(index)+'.pgm')
                koreader=Path(self.config.get('koreader_dir','/mnt/us/koreader'))
                decoder=self.app_dir/'bin/png-scale'
                environment=dict(os.environ,LD_LIBRARY_PATH=str(koreader/'libs'))
                decoded=subprocess.run([str(decoder),str(koreader/'libs/libpng16.so.16'),str(source_png),str(scaled),'1170','1545'],env=environment,stdout=subprocess.PIPE,stderr=subprocess.PIPE,timeout=90,preexec_fn=render_limits)
                if decoded.returncode or not scaled.is_file():raise ValueError('The sheet image could not be safely decoded. Saved lyrics remain available.')
                with Image.open(str(scaled)) as im:
