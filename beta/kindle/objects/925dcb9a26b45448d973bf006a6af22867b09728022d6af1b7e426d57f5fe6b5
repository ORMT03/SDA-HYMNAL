static void wrap_lyrics(const char *body) {
    linecount = 0;
    const char *p = body;
    while (*p && linecount < 1500) {
        char *out = lines[linecount];
        size_t used = 0;
        int cols = 0, last_space = -1;
        const char *after_space = NULL;
        while (*p && *p != '\n' &&
               cols < (setting_int("font_size") >= 30   ? 16
                       : setting_int("font_size") >= 24 ? 23
                                                        : 35)) {
            const char *start = p;
            unsigned c = display_next(&p);
            if (c == '\r')
                continue;
            if (c == ' ') {
                last_space = (int)used;
                after_space = p;
            }
            size_t bytes = (size_t)(p - start);
            if (used + bytes >= 179)
                break;
            memcpy(out + used, start, bytes);
            used += bytes;
            cols++;
        }
        if (*p && *p != '\n' && last_space > 0) {
            used = (size_t)last_space;
            p = after_space;
        }
        if (*p == '\n')
            p++;
        out[used] = 0;
        linecount++;
    }
}
static void result(Job *done, JSON *j, int r) {
    int action = done->action;
    if (done != &background)
        message[0] = 0;
    if(action==J_AUDIO){copy_token(&audio_state,j,r);getstr(j,r,"message",message,sizeof(message));}
    if (action == J_STATUS) {
        getstr(j, r, "app_version", app_version, sizeof(app_version));
        copy_token(&settings, j, field(j, r, "settings"));
        int up = field(j, r, "update");
        available = jtrue(j, field(j, up, "available"));
        getstr(j, up, "message", update_message, sizeof(update_message));
        setting_string("default_language", language, sizeof(language));
        if (!strcmp(language, "last"))
            setting_string("language", language, sizeof(language));
        setting_string("default_view", view, sizeof(view));
        if (!strcmp(view, "last"))
            setting_string("view", view, sizeof(view));
        if (!*language)
            strcpy(language, "english");
        if (!*view)
            strcpy(view, "score");
        search();
        return;
    }
    if (action == J_SEARCH) {
        strcpy(listlanguage, language);
        copy_token(&catalog, j, r);
        copy_token(&settings, j, field(j, r, "settings"));
        screen = HOME;
        if (initial) {
            initial = 0;
            start_job(&background, J_CHECK, "{\"command\":\"check\"}");
        }
    }
    if (action == J_HYMN) {
        copy_token(&hymn, j, r);
        copy_token(&keys, j, r);
        int song = field(j, r, "song");
        char num[12], name[400], lyrics[40000];
        getstr(j, song, "number", num, sizeof(num));
        getstr(j, song, "title", name, sizeof(name));
        snprintf(title, sizeof(title), "%s - %s", num, name);
        getstr(j, r, "original_key", key, sizeof(key));current_key();
        if (!*key)
            strcpy(key, "--");
        getstr(j, r, "lyrics", lyrics, sizeof(lyrics));
        wrap_lyrics(lyrics);
        if(audio_restore){audio_restore=0;screen=AUDIO;menupage=0;viewport[0]=0;imagecount=0;draw();return;}
        show_hymn();
        return;
    }
    if (action == J_RENDER) {
        int a = field(j, r, "images");
        imagecount = 0;
        for (int i = 0; i < 25; i++) {
            int n = array_at(j, a, i);
            if (n < 0)
                break;
            jtext(j, n, images[imagecount++], sizeof(images[0]));
        }
        int info = field(j, r, "hymn");
        if (info >= 0) {
            copy_token(&keys, j, info);
            if (!offset)
                getstr(j, info, "original_key", key, sizeof(key));
        }
        show_page();
        return;
    }
    if (action == J_DISPLAY) {
        getstr(j, r, "image", viewport, sizeof(viewport));
        panx = integer(j, field(j, r, "x"));
        pany = integer(j, field(j, r, "y"));
        maxx = integer(j, field(j, r, "max_x"));
        maxy = integer(j, field(j, r, "max_y"));
        screen = SCORE;
        if(audio_sync){audio_sync=0;audio_command("play",0);return;}
    }
    if (action == J_QR) {
        getstr(j, r, "image", qrimage, sizeof(qrimage));
        screen = QR;
    }
    if (action == J_SETTINGS) {
        copy_token(&settings, j, r);
        if (screen == HOME) {
            setting_string("language", language, sizeof(language));
            listpage = 0;
            search();
            return;
        }
    }
    if (action == J_STORAGE) {
        copy_token(&storage, j, r);
        screen = STORAGE;
    }
    if (action == J_CLEAN || action == J_EXPORT)
        getstr(j, r, "message", message, sizeof(message));
    if (action == J_CHECK) {
        int was_available = available;
        available = jtrue(j, field(j, r, "available"));
        getstr(j, r, "message", update_message, sizeof(update_message));
        if (done != &background && screen == UPDATE)
            snprintf(message, sizeof(message), "%s", update_message);
        if (done == &background) {
            if ((screen == HOME && was_available != available) || screen == UPDATE)
                draw();
            return;
        }
    }
    if (action == J_DOWNLOAD) {
        restart = jtrue(j, field(j, r, "restart"));
        getstr(j, r, "message", message, sizeof(message));
        draw();
        if (restart)
            alive = 0;
    }
    draw();
}
static void poll_job(Job *j) {
    if (!j->pid)
        return;
    FILE *f = fopen(j->response, "rb");
    if (f) {
        fseek(f, 0, SEEK_END);
        long size = ftell(f);
        rewind(f);
        if (size > 0 && size < LIMIT) {
            char *body = calloc((size_t)size + 1, 1);
            if (body) {
                fread(body, 1, (size_t)size, f);
                JSON json;
                if (!jparse(&json, body, (size_t)size)) {
                    if (jtrue(&json, field(&json, 0, "done"))) {
                        int status;
                        waitpid(j->pid, &status, 0);
                        j->pid = 0;
                        unlink(j->request);
                        unlink(j->response);
                        if (jtrue(&json, field(&json, 0, "ok")))
                            result(j, &json, field(&json, 0, "result"));
                        else {
                            getstr(&json, 0, "error", message, sizeof(message));
                            fprintf(stderr, "Worker error: %s\n", message);
                            if (j == &background)
                                message[0] = 0;
                            else if (screen == SCORE && !imagecount) {
                                screen = LYRICS;
                                strcpy(view, "lyrics");
                            }
                            draw();
                        }
                    }
                    free(json.t);
                }
                free(body);
            }
        }
        fclose(f);
    }
    if (j->pid && time(NULL) - j->started > (j->action == J_DOWNLOAD ? 1800 : 240)) {
        kill(-j->pid, SIGTERM);
        waitpid(j->pid, NULL, 0);
        j->pid = 0;
        strcpy(message, "Could not finish. Saved hymns remain available.");
        draw();
    }
}
