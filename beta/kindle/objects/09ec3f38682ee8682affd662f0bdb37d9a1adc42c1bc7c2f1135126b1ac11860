    def protected(self):
        current = read_json(self.root/'current.json',{}); recovery = read_json(self.state/'recovery-app.json',{})
        entries = current.get('app',{}).get('files',[]) + current.get('data',{}).get('files',[]) + recovery.get('files',[])
        return {e['sha256'] for e in entries}, {i for i in [current.get('app',{}).get('id'),recovery.get('id')] if i}

    def storage(self):
        keep, app_ids = self.protected(); active = unused = rendered = 0
        for path in self.store.iterdir():
            if path.is_file():
                if path.name in keep: active += path.stat().st_size
                else: unused += path.stat().st_size
        for path in (self.cache/'scores').rglob('*'):
            if path.is_file(): rendered += path.stat().st_size
        return dict(saved_bytes=active, unused_bytes=unused, rendered_bytes=rendered,
                    selection=self.current.get('data',{}).get('selection'), settings=self.settings(),
                    app_version=self.current.get('app',{}).get('version', VERSION), data_version=self.current.get('data',{}).get('version','Unknown'))

    def _cleanup(self):
        current = read_json(self.root/'current.json',{})
        if not current or not all(self.have(e) for e in current.get('app',{}).get('files',[])+current.get('data',{}).get('files',[])):
            return dict(removed=0, message='Cleanup skipped because the saved hymnal is incomplete.')
        keep, app_ids = self.protected(); removed=0
        for path in self.store.iterdir():
            if path.is_file() and path.name not in keep: path.unlink(); removed+=1
        for path in self.releases.iterdir():
            if path.is_dir() and path.name not in app_ids: shutil.rmtree(str(path))
        return dict(removed=removed, message='Unused files removed. Current and recovery files were kept.')

    def cleanup(self):
        with self.lock(): return self._cleanup()

    def status(self):
        return dict(settings=self.settings(), storage=self.storage(), update=read_json(self.state/'check.json',{}),
                    app_version=self.current.get('app',{}).get('version',VERSION),
                    data_version=self.current.get('data',{}).get('version','Unknown'))

    def dispatch(self, request):
        command = request.get('command')
        actions = dict(status=lambda:self.status(), search=lambda:self.search(request), hymn=lambda:self.hymn(request),
                       settings=lambda:self.save_settings(request.get('changes',{})), check=self.check,
                       download=lambda:self.download(request.get('refresh',True)), render=lambda:self.render(request),
                       share=lambda:self.share(request), qr=lambda:self.qr(request), display=lambda:self.display(request), export=lambda:self.export(request), storage=self.storage, cleanup=self.cleanup)
        if command not in actions: raise ValueError('Unknown app command')
        return actions[command]()

def main():
    parser=argparse.ArgumentParser(); parser.add_argument('--root',required=True); parser.add_argument('--app-dir')
    parser.add_argument('--request',required=True); parser.add_argument('--response',required=True); args=parser.parse_args()
    response=Path(args.response)
    def progress(message,percent): atomic_json(response,dict(done=False,message=message,percent=percent))
    try:
        request=read_json(args.request)
        if not isinstance(request,dict): raise ValueError('Invalid request')
        if request.get('command') in ('render','export'):render_limits()
        result=Hymnal(args.root,args.app_dir,progress).dispatch(request)
        atomic_json(response,dict(done=True,ok=True,result=result))
    except Exception as error:
        atomic_json(response,dict(done=True,ok=False,error=str(error)))
        return 1
    return 0
