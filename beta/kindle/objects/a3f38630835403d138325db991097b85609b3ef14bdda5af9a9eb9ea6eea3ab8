    }if(used){size_t start=used-1;while(start&&((unsigned char)out[start]&0xc0)==0x80)start--;unsigned char lead=(unsigned char)out[start];size_t expected=lead<128?1:lead>=0xc2&&lead<0xe0?2:lead>=0xe0&&lead<0xf0?3:lead>=0xf0&&lead<0xf5?4:1;if(used-start<expected)used=start;}out[used]=0;
}
static int jtrue(JSON *j,int n){return n>=0&&j->t[n].type=='t';}
static char *jquote(const char *text){
    size_t len=strlen(text);if(len>LIMIT)return NULL;char *out=malloc(len*6+3);if(!out)return NULL;size_t u=0;out[u++]='"';
    for(size_t i=0;i<len;i++){unsigned char c=text[i];if(c=='"'||c=='\\'){out[u++]='\\';out[u++]=(char)c;}else if(c<32){snprintf(out+u,7,"\\u%04x",c);u+=6;}else out[u++]=(char)c;}
    out[u++]='"';out[u]=0;return out;
}
