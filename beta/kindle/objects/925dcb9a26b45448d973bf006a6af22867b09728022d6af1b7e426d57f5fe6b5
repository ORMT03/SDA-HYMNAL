/* Read the initial offline list in C; Python is started only for requested work. */
static int read_doc(Doc *doc, const char *path) {
    FILE *file = fopen(path, "rb");
    if (!file)
        return -1;
    if (fseek(file, 0, SEEK_END)) {
        fclose(file);
        return -1;
    }
    long length = ftell(file);
    rewind(file);
    if (length <= 0 || length > LIMIT) {
        fclose(file);
        return -1;
    }
    char *body = malloc((size_t)length + 1);
    if (!body) {
        fclose(file);
        return -1;
    }
    size_t got = fread(body, 1, (size_t)length, file);
    fclose(file);
    body[got] = 0;
    int result = got == (size_t)length ? set_doc(doc, body) : -1;
    free(body);
    return result;
}
