    def search(self,request):
        settings=self.settings();language=request.get('language',settings['language']);query=normalize(request.get('query','')).strip();smart=request.get('smart',settings['smart'])
        identity,related,records=self.version_graph();loaded={identity(s):s for s in self.songs()};catalogs={c['id']:c for c in self.collections()}
        order=list(dict.fromkeys(settings['collection_order']+list(catalogs)));sections=[];shown=set()
        targets=('english','spanish') if language=='both' else (language,)
        for cid in order:
            if cid not in catalogs or not settings['collections_enabled'].get(cid,True):continue
            own=sorted((s for s in self.songs() if s.get('collection','sda')==cid and s['language'] in targets),key=lambda s:(s['language'],s['number']))
            rows=[(s,None) for s in own];local={identity(s) for s in own}
            if settings['include_missing_versions']:
                for anchor in records.values():
                    if anchor.get('collection','sda')!=cid:continue
                    peers=related(identity(anchor))
                    for target in targets:
                        if any(s.get('collection','sda')==cid and s['language']==target for s in peers):continue
                        for peer in peers:
                            key=identity(peer)
                            if key in loaded and key not in local and peer['language']==target:
                                rows.append((loaded[key],anchor));local.add(key)
            unique=[]
            for song,anchor in rows:
