static int array_at(JSON *j, int a, int index) {
    if (!j || !j->t || a < 0 || a >= j->used || j->t[a].type != '[')
        return -1;
    int n = a + 1;
    for (int i = 0; i < index && n < j->t[a].next; i++)
        n = j->t[n].next;
    return n < j->t[a].next ? n : -1;
}
static void prepare_list_layout(void) {
    int array = field(&catalog.j, 0, "songs");
    int grouped = jtrue(&catalog.j, field(&catalog.j, 0, "grouped"));
    int page = 0, y = 160;
    list_visible_count = 0;
    /* Walk JSON tokens directly: every collection/song participates in paging,
       including catalogs larger than the former 1,500-song temporary arrays. */
    int limit = array >= 0 ? catalog.j.t[array].next : 0;
    for (int first = array >= 0 ? array + 1 : 0; first < limit;) {
        int end = catalog.j.t[first].next, rows = 1;
        if (grouped)
            while (end < limit && !jtrue(&catalog.j, field(&catalog.j, end, "group_start"))) {
                rows++;
                end = catalog.j.t[end].next;
            }
        char heading[120];
        getstr(&catalog.j, first, "collection_heading", heading, sizeof(heading));
        int header = *heading ? 48 : 0;
        int height = rows * 48 + header, gap = grouped && y > 160 ? 16 : 0;
        /* Keep a heading with its first song, and keep short search groups together. */
        if (y > 160 && ((height <= 528 && y + gap + height > 688) ||
                        y + gap + header + 48 > 688)) {
            page++;
            y = 160;
            gap = 0;
        }
        y += gap;
        int heading_y = header ? y : 0;
        y += header;
        for (int row = first; row < end; row = catalog.j.t[row].next) {
            if (y + 48 > 688) {
                page++;
                y = 160;
            }
            if (page == listpage && list_visible_count < 11) {
                list_heading_y[list_visible_count] = row == first ? heading_y : 0;
                list_visible[list_visible_count] = row;
                list_y[list_visible_count++] = y;
            }
            y += 48;
        }
        first = end;
    }
    list_page_count = page + 1;
    if (listpage >= list_page_count) {
        listpage = list_page_count - 1;
        prepare_list_layout();
    }
}
/* Draw button surfaces in the framebuffer; no image decoder or Python startup. */
static int rounded_inside(int px, int py, int x, int y, int w, int h, int radius) {
    if (px < x || py < y || px >= x + w || py >= y + h)
        return 0;
    int cx = px < x + radius ? x + radius : px >= x + w - radius ? x + w - radius - 1 : px;
    int cy = py < y + radius ? y + radius : py >= y + h - radius ? y + h - radius - 1 : py;
    int dx = px - cx, dy = py - cy;
    return dx * dx + dy * dy <= radius * radius;
}
static void control_box(unsigned char *pixels, const struct fb_fix_screeninfo *fixed,
                        const struct fb_var_screeninfo *variable, int x, int y, int w, int h,
                        int disabled, int selected) {
    for (int py = y; py < y + h && py < 800; py++)
        for (int px = x; px < x + w && px < 600; px++) {
            if (px < 0 || py < 0 || !rounded_inside(px, py, x, y, w, h, 8))
                continue;
            size_t offset =
                (size_t)(py + variable->yoffset) * fixed->line_length + px + variable->xoffset;
            int outline = !rounded_inside(px, py, x + 2, y + 2, w - 4, h - 4, 6);
            if (outline)
                pixels[offset] = disabled ? 190 : 65;
            else if (disabled && pixels[offset] < 210)
                pixels[offset] = 155;
            else if (pixels[offset] > 235)
                pixels[offset] = selected ? 226 : disabled ? 250 : 244;
        }
}
static void decorate(void) {
    extern int offset;
    int fd = open("/dev/fb0", O_RDWR);
    struct fb_fix_screeninfo fixed;
    struct fb_var_screeninfo variable;
    if (fd < 0)
        return;
    if (!framebuffer_layout(fd, &fixed, &variable)) {
        close(fd);
        return;
    }
    size_t size = (size_t)fixed.line_length * (variable.yres + variable.yoffset);
    unsigned char *mapped = mmap(NULL, size, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
