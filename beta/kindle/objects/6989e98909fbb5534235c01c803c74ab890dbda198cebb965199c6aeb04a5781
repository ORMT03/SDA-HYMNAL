    def save_recording(self,e,target=None,cancel=None):
        target=target or self.recording_file(e);target.parent.mkdir(parents=True,exist_ok=True)
        if shutil.disk_usage(target.parent).free<e['bytes']+20000000:raise ValueError('Not enough storage for this recording.')
        partial=target.with_suffix(target.suffix+'.part')
        try:
            with urllib.request.urlopen(e['url'],timeout=30,context=self.recording_ssl()) as response,partial.open('wb') as out:
                total=0
                while True:
                    if cancel is not None and cancel.is_set():raise InterruptedError('Download cancelled. Completed recordings are kept.')
                    block=response.read(65536)
                    if not block:break
                    total+=len(block)
                    if total>e['bytes']:raise ValueError('Recording size mismatch.')
                    out.write(block)
            if total!=e['bytes']:raise ValueError('Recording was incomplete.')
            os.replace(partial,target)
        finally:
            if partial.exists():partial.unlink()

    def delete_recordings(self,language=None,number=None):
        for e in self.recording_entries(language,number):
            for p in (self.root/'audio').glob(e['id']+'-*'):
                if p.is_file():p.unlink()
        if language is None and number is None:
            for p in (self.root/'audio').glob('*'):
                if p.is_file():p.unlink()

    def audio(self,request):
        directory=self.state/'audio';directory.mkdir(parents=True,exist_ok=True)
        state=read_json(directory/'status.json',{});pid=state.get('pid',0);running=False
        if pid:
            try:running=b'audio_worker.py' in Path('/proc/%d/cmdline'%pid).read_bytes() and str(self.root).encode() in Path('/proc/%d/cmdline'%pid).read_bytes()
            except OSError:pass
        action=request.get('action','status')
        if action!='status':
            if not running:
                atomic_json(directory/'request.json',{})
                log=(directory/'worker.log').open('ab')
                subprocess.Popen([sys.executable,str(self.app_dir/'audio_worker.py'),str(self.root),str(self.app_dir)],stdin=subprocess.DEVNULL,stdout=log,stderr=log,start_new_session=True,close_fds=True);log.close()
                for _ in range(40):
                    time.sleep(.05);state=read_json(directory/'status.json',{})
                    if state.get('pid'):break
            command=dict(request,id=str(time.time_ns()))
            atomic_json(directory/'request.json',command)
            for _ in range(8):
                time.sleep(.05);state=read_json(directory/'status.json',{})
                if state.get('ack')==command['id']:break
        else:
            if not running:state.update(playing=False,paused=False,pid=0)
        entries=self.recording_entries(request.get('catalog_language'))
        state['recordings']=[dict(e,downloaded=self.recording_file(e).exists()) for e in entries]
        state['stored_bytes']=sum(p.stat().st_size for p in (self.root/'audio').glob('*') if p.is_file() and p.suffix in ('.mp3','.m4a'))
        state.pop('sections',None)
        return state

    def dispatch(self, request):
        command = request.get('command')
        actions = dict(audio=lambda:self.audio(request), status=lambda:self.status(), search=lambda:self.search(request), hymn=lambda:self.hymn(request),
                       settings=lambda:self.save_settings(request.get('changes',{})), check=self.check,
                       download=lambda:self.download(request.get('refresh',True)), render=lambda:self.render(request),
                       share=lambda:self.share(request), qr=lambda:self.qr(request), display=lambda:self.display(request), export=lambda:self.export(request), storage=self.storage, cleanup=self.cleanup)
        if command not in actions: raise ValueError('Unknown app command')
        return actions[command]()

def main():
    parser=argparse.ArgumentParser(); parser.add_argument('--root',required=True); parser.add_argument('--app-dir')
    parser.add_argument('--request',required=True); parser.add_argument('--response',required=True); args=parser.parse_args()
    response=Path(args.response)
    def progress(message,percent): atomic_json(response,dict(done=False,message=message,percent=percent))
    try:
        request=read_json(args.request)
        if not isinstance(request,dict): raise ValueError('Invalid request')
        if request.get('command') in ('render','export'):render_limits()
        result=Hymnal(args.root,args.app_dir,progress).dispatch(request)
        atomic_json(response,dict(done=True,ok=True,result=result))
    except Exception as error:
        atomic_json(response,dict(done=True,ok=False,error=str(error)))
        return 1
    return 0
if __name__=='__main__': raise SystemExit(main())
