static int touch_axes(int fd, struct input_absinfo *x, struct input_absinfo *y) {
    if (ioctl(fd, EVIOCGABS(ABS_MT_POSITION_X), x) == 0 &&
        ioctl(fd, EVIOCGABS(ABS_MT_POSITION_Y), y) == 0)
        return x->maximum > x->minimum && y->maximum > y->minimum;
    unsigned char keybits[(KEY_MAX + 8) / 8] = {0};
    if (ioctl(fd, EVIOCGBIT(EV_KEY, sizeof(keybits)), keybits) < 0 ||
        !(keybits[BTN_TOUCH / 8] & (1u << (BTN_TOUCH % 8))))
        return 0;
    return ioctl(fd, EVIOCGABS(ABS_X), x) == 0 && ioctl(fd, EVIOCGABS(ABS_Y), y) == 0 &&
           x->maximum > x->minimum && y->maximum > y->minimum;
}
static int open_touch(struct input_absinfo *x, struct input_absinfo *y) {
    for (int i = 0; i < 32; i++) {
        char path[80];
        snprintf(path, sizeof(path), "/dev/input/event%d", i);
        int fd = open(path, O_RDONLY | O_NONBLOCK);
        if (fd < 0)
            continue;
        if (touch_axes(fd, x, y)) {
            fprintf(stderr, "Touch input: %s\n", path);
            fcntl(fd, F_SETFD, FD_CLOEXEC);
            ioctl(fd, EVIOCGRAB, 1);
            return fd;
        }
        close(fd);
    }
    return -1;
}
static int mapped(int value, struct input_absinfo *axis, int maximum) {
    int result = (value - axis->minimum) * maximum / (axis->maximum - axis->minimum);
    return result < 0 ? 0 : result > maximum ? maximum : result;
}
