static int framebuffer_layout(int fd, struct fb_fix_screeninfo *fixed,
                              struct fb_var_screeninfo *variable) {
    return ioctl(fd, FBIOGET_FSCREENINFO, fixed) == 0 &&
           ioctl(fd, FBIOGET_VSCREENINFO, variable) == 0 && variable->bits_per_pixel == 8 &&
           variable->xres >= 600 && variable->yres >= 800;
}
static void image(const char *path, int y, int w, int h, int clear) {
    if (clear)
        text(" ", 0, 1, 1);
    int input = open(path, O_RDONLY), fb = open("/dev/fb0", O_RDWR);
    struct fb_fix_screeninfo fixed;
    struct fb_var_screeninfo variable;
    if (input < 0 || fb < 0 || !framebuffer_layout(fb, &fixed, &variable)) {
        fprintf(stderr, "Unable to open native score framebuffer\n");
    } else {
        unsigned char row[600];
        for (int i = 0; i < h && i + y < 800; i++) {
            if (read(input, row, (size_t)w) != w)
                break;
            off_t offset = (off_t)(i + y + variable.yoffset) * fixed.line_length + variable.xoffset;
            if (pwrite(fb, row, (size_t)w, offset) != w)
                break;
        }
    }
    if (input >= 0)
        close(input);
    if (fb >= 0)
        close(fb);
}
