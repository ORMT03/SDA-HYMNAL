static void start_job(Job *j, int action, const char *json) {
    if (j->pid)
        return;
    static unsigned serial;
    snprintf(j->request, sizeof(j->request), "%s/state/jobs/native-%ld-%u.request.json", root,
             (long)getpid(), ++serial);
    snprintf(j->response, sizeof(j->response), "%s/state/jobs/native-%ld-%u.response.json", root,
             (long)getpid(), serial);
    FILE *f = fopen(j->request, "wb");
    if (!f)
        return;
    fputs(json, f);
    fclose(f);
    char backend[1100];
    snprintf(backend, sizeof(backend), "%s/backend.py", app);
    pid_t p = fork();
    if (!p) {
        setpgid(0, 0);
        execl(python, python, backend, "--root", root, "--app-dir", app, "--request", j->request,
              "--response", j->response, (char *)NULL);
        _exit(127);
    }
    if (p < 0)
        return;
    j->pid = p;
    j->action = action;
    j->started = time(NULL);
}
static void command(int action, const char *json) {
    if (job.pid)
        return;
    snprintf(message, sizeof(message), "%s",
             action == J_RENDER     ? "Preparing score..."
             : action == J_DOWNLOAD ? "Downloading..."
             : action == J_CHECK    ? "Checking for updates..."
                                    : "Loading...");
    draw();
    start_job(&job, action, json);
}
