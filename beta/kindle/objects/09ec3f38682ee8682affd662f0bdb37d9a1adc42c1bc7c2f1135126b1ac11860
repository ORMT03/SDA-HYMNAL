    def render(self, request):
        song = self.find_song(request['language'], request['number'])
        if not song: raise ValueError('This hymn is not saved in the selected language.')
        settings = self.settings(); scope = request.get('scope', 'view')
        if scope not in ('view', 'share'): raise ValueError('Invalid score settings')
        options = settings[scope + '_options']; offset = int(request.get('offset', 0))
