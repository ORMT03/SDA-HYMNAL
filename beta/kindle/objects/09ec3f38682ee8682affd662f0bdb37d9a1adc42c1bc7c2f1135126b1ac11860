                    paper=Image.new('RGB',(1275,1650),'white');paper.paste(im,((1275-im.width)//2,(1650-im.height)//2))
                    png=folder/('original-'+str(index)+'.png');paper.save(str(png));paper.close()
                source_png.unlink(missing_ok=True);scaled.unlink(missing_ok=True)
                pngs.append(png)
        pages = [Image.open(str(p)).convert('RGB') for p in pngs]
        try:
