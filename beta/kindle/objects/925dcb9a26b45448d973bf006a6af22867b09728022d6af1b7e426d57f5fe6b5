static int run(char *const argv[]) {
    pid_t p = fork();
    if (!p) {
        execv(argv[0], argv);
        _exit(127);
    }
    int status = 0;
    if (p < 0)
        return -1;
    while (waitpid(p, &status, 0) < 0 && errno == EINTR) {
    }
    return WIFEXITED(status) ? WEXITSTATUS(status) : -1;
}
