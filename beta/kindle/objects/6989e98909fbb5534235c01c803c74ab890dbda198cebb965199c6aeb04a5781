    def refresh_recordings(self):
        url='https://raw.githubusercontent.com/ORMT03/SDA-HYMNAL/HEAD/audio/catalog.json'
        try:
            with urllib.request.urlopen(url,timeout=15,context=self.recording_ssl()) as response:
                body=response.read(1000001)
        except urllib.error.HTTPError as error:
            if error.code==404:raise ValueError('Recordings have not been published yet. Saved recordings remain available.') from error
            raise ValueError('Unable to refresh the recording catalog. Saved recordings remain available.') from error
        except OSError as error:
            raise ValueError('Unable to refresh the recording catalog. Check Wi-Fi; saved recordings remain available.') from error
        if len(body)>1000000:raise ValueError('Recording catalog is too large.')
        catalog=json.loads(body);seen=set()
        if not isinstance(catalog.get('recordings'),list):raise ValueError('Invalid recording catalog.')
        for e in catalog['recordings']:
            u=urllib.parse.urlsplit(e['url'])
            if e['language'] not in ('en','es') or not str(e['number']).isdigit() or e['id']!=e['language']+'-%03d'%int(e['number']) or e['id'] in seen or not re.fullmatch(r'[A-Za-z0-9_-]+',e['revision']) or not isinstance(e['bytes'],int) or not 0<e['bytes']<=100000000 or u.scheme!='https' or u.netloc!='raw.githubusercontent.com' or not u.path.lower().startswith('/ormt03/sda-hymnal/') or not u.path.lower().endswith(('.mp3','.m4a')):raise ValueError('Invalid recording catalog.')
            seen.add(e['id'])
        atomic_json(self.state/'audio/catalog.json',catalog)
        return catalog

