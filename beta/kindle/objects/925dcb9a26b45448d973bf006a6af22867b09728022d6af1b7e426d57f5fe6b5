}
static int initial_order_compare(const void *a, const void *b) {
    InitialNode *x = &initial_sort_nodes[*(const int *)a],
                *y = &initial_sort_nodes[*(const int *)b];
    int order = strcmp(x->lang, y->lang);
    return order ? order : strcmp(x->number, y->number);
}
static int initial_peer_compare(const void *a, const void *b) {
    InitialNode *x = &initial_sort_nodes[*(const int *)a],
                *y = &initial_sort_nodes[*(const int *)b];
    int order = strcmp(initial_sort_books[x->book].id, initial_sort_books[y->book].id);
    if (order)
        return order;
    order = strcmp(x->lang, y->lang);
    return order ? order : strcmp(x->id, y->id);
}
static int initial_target(const char *lang) {
    return !strcmp(language, "both") || !strcmp(language, lang);
}
static int initial_emit(char *body, size_t *used, InitialNode *song, InitialCollection *book,
                        int first, int comma) {
    char *id = jquote(song->id), *number = jquote(song->number), *title = jquote(song->title),
         *collection = jquote(book->id);
    int written = -1;
    if (id && number && title && collection)
        written = snprintf(
            body + *used, LIMIT - *used,
            "%s{\"id\":%s,\"number\":%s,\"title\":%s,\"collection\":%s,\"language\":\"%s\"",
            comma ? "," : "", id, number, title, collection, song->lang);
    free(id);
    free(number);
    free(title);
    free(collection);
    if (written < 0 || (size_t)written >= LIMIT - *used)
        return -1;
    *used += (size_t)written;
    (void)first;
    return 0;
}
static int initial_collections(Doc *manifest) {
    Doc index = {0}, pairs = {0};
    int success = -1;
    if (initial_blob(manifest, "collections.json", NULL, &index))
        return -1;
    int definitions = field(&index.j, 0, "collections"),
        records = field(&index.j, 0, "versionIndex");
    if (definitions < 0 || records < 0) {
        clear_doc(&index);
        return -1;
    }
    int bookcount = index.j.t[definitions].count, count = index.j.t[records].count;
    InitialCollection *books = calloc((size_t)bookcount + 1, sizeof(*books));
    InitialNode *nodes = calloc((size_t)count + 1, sizeof(*nodes));
    int *order = calloc((size_t)bookcount + 1, sizeof(int)),
        *own = calloc((size_t)count + 1, sizeof(int)),
        *peers = calloc((size_t)count + 1, sizeof(int));
    unsigned char *shown = calloc((size_t)count + 1, 1), *local = calloc((size_t)count + 1, 1),
                  *has = calloc(((size_t)count + 1) * 2, 1);
    char *body = calloc(LIMIT, 1);
    if (!books || !nodes || !order || !own || !peers || !shown || !local || !has || !body)
        goto cleanup;
    for (int i = 0, n = definitions + 1; i < bookcount; i++, n = index.j.t[n].next) {
        InitialCollection *b = &books[i];
        b->token = n;
        getstr(&index.j, n, "id", b->id, sizeof(b->id));
        getstr(&index.j, n, "name", b->name, sizeof(b->name));
        int sources = field(&index.j, n, "catalogs");
        for (int src = sources >= 0 ? sources + 1 : 0;
             sources >= 0 && src < index.j.t[sources].next; src = index.j.t[src].next) {
            char url[200], lang[20];
            getstr(&index.j, src, "url", url, sizeof(url));
            getstr(&index.j, src, "language", lang, sizeof(lang));
            const char *legacy = !strcmp(url, "../songs.json")      ? "catalogs/songs.json"
                                 : !strcmp(url, "../songs_es.json") ? "catalogs/songs_es.json"
                                                                    : NULL;
            if (!initial_blob(manifest, url, legacy, NULL)) {
                if (!strcmp(lang, "english"))
                    b->english = 1;
                if (!strcmp(lang, "spanish"))
                    b->spanish = 1;
            }
        }
    }
    /* Refresh menu definitions immediately too; a saved two-collection menu must
       not hide newer collections until a Python status request finishes. */
    {
        int n = definitions;
        size_t len = (size_t)(index.j.t[n].end - index.j.t[n].start), old = strlen(settings.body);
        char *updated = malloc(old + len + 40);
        if (!updated)
            goto cleanup;
        snprintf(updated, old + len + 40, "%.*s%s\"collection_list\":%.*s}", (int)(old - 1),
                 settings.body, old > 2 ? "," : "", (int)len, index.body + index.j.t[n].start);
        /* Remove the older field first: the small JSON reader uses the first match. */
        int prior = field(&settings.j, 0, "collection_list");
        if (prior >= 0) {
            int start = settings.j.t[prior - 1].start, end = settings.j.t[prior].end;
            while (start > 0 && settings.body[start - 1] == ' ')
                start--;
            if (start > 0 && settings.body[start - 1] == ',')
                start--;
            else {
                while (settings.body[end] == ' ')
                    end++;
                if (settings.body[end] == ',')
                    end++;
            }
            char *base = strdup(settings.body);
            memmove(base + start, base + end, old - (size_t)end + 1);
            snprintf(updated, old + len + 40, "%.*s%s\"collection_list\":%.*s}",
                     (int)(strlen(base) - 1), base, strlen(base) > 2 ? "," : "", (int)len,
                     index.body + index.j.t[n].start);
            free(base);
        }
        set_doc(&settings, updated);
        free(updated);
    }
    int orders = field(&settings.j, 0, "collection_order"), ordered = 0;
    for (int n = orders >= 0 ? orders + 1 : 0; orders >= 0 && n < settings.j.t[orders].next;
         n = settings.j.t[n].next) {
        char id[100];
        jtext(&settings.j, n, id, sizeof(id));
        int i = initial_find_book(books, bookcount, id), seen = 0;
        for (int j = 0; j < ordered; j++)
            if (order[j] == i)
                seen = 1;
        if (i >= 0 && !seen)
            order[ordered++] = i;
    }
    for (int i = 0; i < bookcount; i++) {
        int seen = 0;
        for (int j = 0; j < ordered; j++)
            if (order[j] == i)
                seen = 1;
        if (!seen)
            order[ordered++] = i;
    }
    int usednodes = 0;
    for (int n = records + 1; n < index.j.t[records].next; n = index.j.t[n].next) {
        char cid[100];
        getstr(&index.j, n, "collection", cid, sizeof(cid));
        int book = initial_find_book(books, bookcount, cid);
        if (book < 0)
            continue;
        InitialNode *s = &nodes[usednodes];
        s->book = book;
        s->parent = usednodes;
        s->token = n;
        getstr(&index.j, n, "id", s->id, sizeof(s->id));
        getstr(&index.j, n, "number", s->number, sizeof(s->number));
        getstr(&index.j, n, "title", s->title, sizeof(s->title));
        getstr(&index.j, n, "language", s->lang, sizeof(s->lang));
        getstr(&index.j, n, "versionGroup", s->group, sizeof(s->group));
        s->loaded = !strcmp(s->lang, "english") ? books[book].english : books[book].spanish;
        peers[usednodes] = usednodes;
        usednodes++;
    }
    count = usednodes;
    initial_sort_nodes = nodes;
    initial_sort_books = books;
    for (int i = 0; i < count; i++) {
        InitialNode *s = &nodes[i];
        int refs = field(&index.j, s->token, "relatedTo");
        for (int n = refs >= 0 ? refs + 1 : 0; refs >= 0 && n < index.j.t[refs].next;
             n = index.j.t[n].next)
            initial_ref(nodes, count, books, bookcount, i, &index.j, n);
        initial_ref(nodes, count, books, bookcount, i, &index.j,
                    field(&index.j, s->token, "translationOf"));
        if (*s->group)
            for (int j = 0; j < i; j++)
                if (!strcmp(s->group, nodes[j].group))
                    initial_join(nodes, i, j);
    }
    if (!initial_blob(manifest, "../song_mapping.json", "catalogs/song_mapping.json", &pairs)) {
        int sda = initial_find_book(books, bookcount, "sda");
        for (int pair = 1; pair < pairs.j.t[0].next; pair = pairs.j.t[pair].next) {
            int first = -1;
            const char *langs[] = {"english", "spanish"};
            for (int k = 0; k < 2; k++) {
                int value = field(&pairs.j, pair, langs[k]);
                if (value < 0)
                    continue;
                int array = pairs.j.t[value].type == '[';
                for (int n = array ? value + 1 : value; n < pairs.j.t[value].next;
                     n = array ? pairs.j.t[n].next : pairs.j.t[value].next) {
                    char id[100], padded[100];
                    jtext(&pairs.j, n, id, sizeof(id));
                    snprintf(padded, sizeof(padded), "%03d", atoi(id));
                    int found = initial_find(nodes, count, sda, langs[k], padded);
                    if (found >= 0) {
                        if (first < 0)
                            first = found;
                        else
                            initial_join(nodes, first, found);
                    }
                }
            }
        }
    }
    /* related() sorts by collection id, language, id, independent of display order. */
    qsort(peers, (size_t)count, sizeof(int), initial_peer_compare);

    size_t used = (size_t)snprintf(body, LIMIT, "{\"grouped\":false,\"songs\":[");
    int emitted = 0;
    int enabled = field(&settings.j, 0, "collections_enabled"),
        missing = field(&settings.j, 0, "include_missing_versions");
    for (int o = 0; o < ordered; o++) {
        int cid = order[o], flag = field(&settings.j, enabled, books[cid].id);
        if (flag >= 0 && !jtrue(&settings.j, flag))
            continue;
        memset(local, 0, (size_t)count);
        memset(has, 0, ((size_t)count + 1) * 2);
        int nown = 0;
        for (int i = 0; i < count; i++)
            if (nodes[i].book == cid) {
                has[initial_root(nodes, i) * 2 + (!strcmp(nodes[i].lang, "spanish"))] = 1;
                if (nodes[i].loaded && initial_target(nodes[i].lang)) {
                    own[nown++] = i;
                    local[i] = 1;
                }
            }
        qsort(own, (size_t)nown, sizeof(int), initial_order_compare);
        if (missing < 0 || jtrue(&settings.j, missing)) {
            for (int anchor = 0; anchor < count; anchor++)
                if (nodes[anchor].book == cid) {
                    int component = initial_root(nodes, anchor);
                    const char *langs[] = {"english", "spanish"};
                    for (int k = 0; k < 2; k++)
                        if (initial_target(langs[k]) && !has[component * 2 + k]) {
                            for (int p = 0; p < count; p++) {
                                int i = peers[p];
                                if (nodes[i].loaded && !local[i] &&
                                    !strcmp(nodes[i].lang, langs[k]) &&
                                    initial_root(nodes, i) == component) {
                                    own[nown++] = i;
                                    local[i] = 1;
                                }
                            }
                        }
                }
        }
        int first = 1;
        for (int n = 0; n < nown; n++) {
            int i = own[n];
            if (shown[i])
                continue;
            shown[i] = 1;
            if (initial_emit(body, &used, &nodes[i], &books[nodes[i].book], first, emitted))
                goto cleanup;
            if (first) {
                char *heading = jquote(books[cid].name);
                if (!heading)
                    goto cleanup;
                int w = snprintf(body + used, LIMIT - used, ",\"collection_heading\":%s", heading);
                free(heading);
                if (w < 0 || (size_t)w >= LIMIT - used)
                    goto cleanup;
                used += (size_t)w;
                first = 0;
            }
            if (used + 2 >= LIMIT)
                goto cleanup;
            body[used++] = '}';
            body[used] = 0;
            emitted++;
        }
    }
    {
        int written = snprintf(body + used, LIMIT - used, "],\"count\":%d,\"settings\":%s}",
                               emitted, settings.body);
        if (written < 0 || (size_t)written >= LIMIT - used)
            goto cleanup;
        success = set_doc(&catalog, body);
    }
cleanup:
    free(books);
    free(nodes);
    free(order);
    free(own);
    free(peers);
    free(shown);
    free(local);
    free(has);
    free(body);
    initial_sort_nodes = NULL;
    initial_sort_books = NULL;
    clear_doc(&index);
    clear_doc(&pairs);
    return success;
}
static int refresh_initial_collections(void) {
    char file[1000];
    snprintf(file, sizeof(file), "%s/current.json", root);
    Doc manifest = {0};
    if (read_doc(&manifest, file))
        return -1;
    int result = initial_collections(&manifest);
    clear_doc(&manifest);
    return result;
}

static int fast_start(void) {
    static const char defaults[] = {
        "{\"language\":\"english\",\"recording_language\":\"english\",\"view\":\"score\",\"default_language\":\"last\",\"default_"
        "view\":\"last\",\"smart\":false,\"allow_exports\":false,\"font_size\":18,\"list_"
        "behavior\":\"top\",\"keep_awake\":false,\"offline_language\":\"both\",\"offline_scores\":"
        "true,\"view_options\":{\"chords\":false,\"lyrics\":true,\"credits\":true,\"heading\":true,"
        "\"copyright\":true},\"share_options\":{\"chords\":false,\"lyrics\":true,\"credits\":true,"
        "\"heading\":true,\"copyright\":true}}"};
    char path[1000];
    snprintf(path, sizeof(path), "%s/state/settings.json", root);
    if (read_doc(&settings, path))
        set_doc(&settings, defaults);
    setting_string("default_language", language, sizeof(language));
    if (!strcmp(language, "last"))
        setting_string("language", language, sizeof(language));
    if (!*language)
        strcpy(language, "english");
    setting_string("default_view", view, sizeof(view));
    if (!strcmp(view, "last"))
        setting_string("view", view, sizeof(view));
    if (!*view)
        strcpy(view, "score");
    Doc manifest = {0};
    snprintf(path, sizeof(path), "%s/current.json", root);
    if (read_doc(&manifest, path))
        return -1;
    getstr(&manifest.j, field(&manifest.j, 0, "app"), "version", app_version, sizeof(app_version));
    if(!initial_collections(&manifest)){clear_doc(&manifest);goto ready;}
    InitialSong *songs = calloc(1500, sizeof(*songs));
    if (!songs) {
        clear_doc(&manifest);
        return -1;
    }
    int count = 0, error = 0;
    if (strcmp(language, "spanish"))
        error |= initial_catalog(&manifest, "catalogs/songs.json", "english", songs, &count);
    if (strcmp(language, "english"))
        error |= initial_catalog(&manifest, "catalogs/songs_es.json", "spanish", songs, &count);
    clear_doc(&manifest);
    if (error) {
        free(songs);
        return -1;
    }
    qsort(songs, (size_t)count, sizeof(*songs), song_compare);
    char *body = calloc(LIMIT, 1);
    if (!body) {
        free(songs);
        return -1;
    }
    size_t used = 0;
    used += (size_t)snprintf(body, LIMIT, "{\"count\":%d,\"songs\":[", count);
    for (int i = 0; i < count; i++) {
        char *number_json = jquote(songs[i].number), *title_json = jquote(songs[i].title);
        if (!number_json || !title_json) {
            free(number_json);
            free(title_json);
            free(body);
            free(songs);
            return -1;
        }
        int written = snprintf(body + used, LIMIT - used,
                               "%s{\"number\":%s,\"title\":%s,\"language\":\"%s\"}", i ? "," : "",
                               number_json, title_json, songs[i].language);
        free(number_json);
        free(title_json);
        if (written < 0 || (size_t)written >= LIMIT - used) {
            free(body);
            free(songs);
            return -1;
        }
        used += (size_t)written;
    }
    if (used + 3 >= LIMIT) {
        free(body);
        free(songs);
        return -1;
    }
    strcpy(body + used, "]}");
    int result = set_doc(&catalog, body);
    free(body);
    free(songs);
    if (result)
        return -1;
ready:
    strcpy(listlanguage, language);
    Doc notice = {0};
    snprintf(path, sizeof(path), "%s/state/check.json", root);
    if (!read_doc(&notice, path)) {
        available = jtrue(&notice.j, field(&notice.j, 0, "available"));
        getstr(&notice.j, 0, "message", update_message, sizeof(update_message));
    }
    clear_doc(&notice);
    initial = 0;
    return 0;
}

static void smoke_tick(void) {
    static int step;
    static time_t when;
    if (!getenv("SDA_HYMNAL_SMOKE") || job.pid || time(NULL) - when < 2)
        return;
    char path[1000];
    if ((step == 0 && screen == HOME && catalog.body) || (step == 1 && screen == SCORE) ||
        (step == 2 && screen == LYRICS) || (step == 3 && screen == QR) ||
        (step == 4 && screen == SCORE)) {
        snprintf(path, sizeof(path), "%s/state/native-smoke-%d.raw", root, step);
        int in = open("/dev/fb0", O_RDONLY), out = open(path, O_WRONLY | O_CREAT | O_TRUNC, 0600);
        unsigned char row[600];
        struct fb_fix_screeninfo fixed;
        struct fb_var_screeninfo variable;
        if (in >= 0 && out >= 0 && framebuffer_layout(in, &fixed, &variable))
            for (int i = 0; i < 800; i++) {
                off_t offset = (off_t)(i + variable.yoffset) * fixed.line_length + variable.xoffset;
                if (pread(in, row, sizeof(row), offset) != sizeof(row))
                    break;
                if (write(out, row, sizeof(row)) != sizeof(row))
                    break;
            }
        if (in >= 0)
            close(in);
        if (out >= 0)
            close(out);
        if (step == 0)
            tap(200, 180);
        else if (step == 1)
            action(A_VIEW);
        else if (step == 2)
            action(A_SHARE);
        else if (step == 3) {
            key_start=7;key_return=screen;screen = KEYS;
            tap(200, 80 + 7 * 48 + 10);
        } else
            alive = 0;
        step++;
        when = time(NULL);
    }
}
int main(int argc, char **argv) {
    if (argc < 4) {
        fprintf(stderr, "Usage: hymnal ROOT APP FBINK\n");
        return 1;
    }
    snprintf(root, sizeof(root), "%s", argv[1]);
    snprintf(app, sizeof(app), "%s", argv[2]);
    snprintf(fbink, sizeof(fbink), "%s", argv[3]);
    signal(SIGTERM, stop_signal);
    signal(SIGINT, stop_signal);
    signal(SIGHUP, stop_signal);
    signal(SIGUSR1, request_redraw);
    struct input_absinfo ax, ay;
    int touch = open_touch(&ax, &ay), home = open("/dev/input/event2", O_RDONLY | O_NONBLOCK);
    if (home >= 0) {
        fcntl(home, F_SETFD, FD_CLOEXEC);
        ioctl(home, EVIOCGRAB, 1);
    }
    if (touch < 0) {
        text("Touchscreen unavailable", 1, 1, 0);
        return 1;
    }
    start_power_events();
    hide_statusbar();
    struct timespec settle = {0, 300000000};
    nanosleep(&settle, NULL);
    if (!fast_start()) {
        draw();
        start_job(&background, J_CHECK, "{\"command\":\"check\"}");
    } else
        command(J_STATUS, "{\"command\":\"status\"}");
    TouchPoint points[2] = {{0}}, frame[2];
    points[0].x = mapped(ax.value, &ax, 599);
    points[0].y = mapped(ay.value, &ay, 799);
    Gesture gesture = {0}, result_g;
    int slot = 0;
    time_t awake_sent = 0;
    while (alive) {
        static time_t audio_checked;
        if(time(NULL)-audio_checked>=5&&!job.pid){
            audio_checked=time(NULL);char statepath[1100];snprintf(statepath,sizeof(statepath),"%s/state/audio/status.json",root);
            int was_visible=audio_visible();if(!read_doc(&audio_state,statepath)){if(screen==AUDIO||screen==AUDIO_STORAGE){getstr(&audio_state.j,0,"message",message,sizeof(message));draw();}else if(screen==HOME&&was_visible!=audio_visible())draw();}
        }
        poll_job(&job);
        poll_job(&background);
        smoke_tick();
        read_power_events();
        time_t now = time(NULL);
        if (redraw_requested || (wake_redraw && now >= wake_redraw) ||
            (wake_redraw_again && now >= wake_redraw_again)) {
            redraw_requested = 0;
            if (wake_redraw && now >= wake_redraw)
                wake_redraw = 0;
            if (wake_redraw_again && now >= wake_redraw_again)
                wake_redraw_again = 0;
            hide_statusbar();
            draw();
        }
        int awake =
            jtrue(&audio_state.j,field(&audio_state.j,0,"playing")) || (setting_bool("keep_awake") && (screen == LYRICS || screen == SCORE || screen == QR));
        if (now - awake_sent >= 25) {
            char *args[] = {"/usr/bin/lipc-set-prop", "com.lab126.powerd", "preventScreenSaver",
                            awake ? "1" : "0", NULL};
            run(args);
            awake_sent = now;
        }
        struct input_event ev;
        while (read(touch, &ev, sizeof(ev)) == sizeof(ev)) {
            if (screen_sleeping)
                continue;
            if (ev.type == EV_ABS) {
                if (ev.code == ABS_MT_SLOT)
                    slot = ev.value >= 0 && ev.value < 2 ? ev.value : 2;
                else if (slot < 2) {
                    if (ev.code == ABS_MT_TRACKING_ID)
                        points[slot].down = ev.value >= 0;
                    else if (ev.code == ABS_MT_POSITION_X || ev.code == ABS_X)
                        points[slot].x = mapped(ev.value, &ax, 599);
                    else if (ev.code == ABS_MT_POSITION_Y || ev.code == ABS_Y)
                        points[slot].y = mapped(ev.value, &ay, 799);
                }
            } else if (ev.type == EV_KEY && ev.code == BTN_TOUCH && !ev.value) {
                points[0].down = points[1].down = 0;
            } else if (ev.type == EV_KEY && ev.code == BTN_TOUCH && ev.value)
                points[0].down = 1;
            else if (ev.type == EV_SYN && ev.code == SYN_DROPPED) {
                memset(points, 0, sizeof(points));
                memset(&gesture, 0, sizeof(gesture));
            } else if (ev.type == EV_SYN && ev.code == SYN_REPORT) {
                memcpy(frame, points, sizeof(frame));
                int kind = gesture_frame(&gesture, frame, &result_g);
                if (kind)
                    gesture_action(kind, &result_g);
            }
        }
        if (home >= 0)
            while (read(home, &ev, sizeof(ev)) == sizeof(ev))
                if (ev.type == EV_KEY && ev.code == KEY_HOME && !ev.value)
                    alive = 0;
        struct timespec delay = {0, 80000000};
        nanosleep(&delay, NULL);
    }
    stop_job(&job);
    stop_job(&background);
    stop_power_events();
    char *args[] = {"/usr/bin/lipc-set-prop", "com.lab126.powerd", "preventScreenSaver", "0", NULL};
    run(args);
    ioctl(touch, EVIOCGRAB, 0);
    close(touch);
    if (home >= 0) {
        ioctl(home, EVIOCGRAB, 0);
        close(home);
    }
    clear_doc(&catalog);
    clear_doc(&hymn);
    clear_doc(&keys);
    clear_doc(&settings);
    clear_doc(&storage);
    char quitpath[1100];snprintf(quitpath,sizeof(quitpath),"%s/state/audio/request.json",root);FILE *quit=fopen(quitpath,"w");if(quit){fprintf(quit,"{\"id\":\"exit-%ld\",\"action\":\"quit\"}",(long)time(NULL));fclose(quit);}
    clear_doc(&audio_state);
    return restart ? 75 : 0;
}
