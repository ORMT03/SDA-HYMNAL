        int closed = 0;
        while (j->pos < j->len) {
            unsigned char c = j->s[j->pos++]; if (c == '"') { closed = 1; break; }
            if (c < 32) { j->error = 1; break; }
            if (c == '\\') {
                if (j->pos >= j->len) break;
                char e = j->s[j->pos++];
                if (e == 'u') { for (int k=0;k<4;k++) if (j->pos >= j->len || !isxdigit((unsigned char)j->s[j->pos++])) { j->error=1; break; } }
                else if (!strchr("\"\\/bfnrt", e)) { j->error=1; break; }
            }
        }
