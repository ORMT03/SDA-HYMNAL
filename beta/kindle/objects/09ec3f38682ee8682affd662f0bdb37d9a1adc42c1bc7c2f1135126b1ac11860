        mapping = self.content_json('catalogs/scores.json', {}); score = mapping.get(song['language'] + ':' + song['number'])
        identity = dict(hymn=song['language']+song['number'], offset=offset, options=options,
                        data=self.current.get('data', {}).get('id'), app=self.current.get('app', {}).get('id'))
        cache_id = hashlib.sha256(json.dumps(identity, sort_keys=True).encode()).hexdigest()[:24]
        folder = self.cache / 'scores' / cache_id; pdf = folder / 'score.pdf'
        if pdf.is_file() and not request.get('refresh'): return dict(pdf=str(pdf), images=[str(p) for p in sorted(folder.glob('*.png')) if p.name != 'display.png'], image_fallback=not bool(score), cached=True,hymn=read_json(folder/'hymn.json',self.hymn(request)))
        folder.mkdir(parents=True, exist_ok=True)
        from PIL import Image
        pngs = []
        if score:
            source = self.obtain_content(score); tree = ET.parse(str(source)); root = tree.getroot()
            metadata = score_metadata(root, song)
            if not options['chords']:
