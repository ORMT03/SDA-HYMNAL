        return dict(versions=versions,song=song, lyrics=lyrics_text(song), has_score=bool(score), original_key=major[tonic] + (' minor' if minor else '') if fifths is not None else None, keys=keys if fifths is not None else [])

    def _draw_metadata(self, image, metadata, song, options, first, last):
