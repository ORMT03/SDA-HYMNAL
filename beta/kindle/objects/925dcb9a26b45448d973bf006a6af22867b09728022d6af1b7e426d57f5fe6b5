static void cleanline(char *out, size_t cap, const char *s, int cols) {
    display_copy(out, cap, s, (size_t)cols);
    for (char *p = out; *p; p++)
        if (*p == '\n' || *p == '\r' || *p == '\t')
            *p = ' ';
}
static void append(char *out, size_t cap, int row, const char *s) {
    int current = 0;
    for (char *p = out; *p; p++)
        if (*p == '\n')
            current++;
    while (current < row && strlen(out) + 1 < cap) {
        strcat(out, "\n");
        current++;
    }
    /* FBInk double-advances a full 36-cell line followed by LF at column 1.
       Keep one spare cell so batched labels stay at their button coordinates. */
#ifndef UI_LINE_COLUMNS
#define UI_LINE_COLUMNS 35
#endif
    char line[256];
    cleanline(line, sizeof(line), s, UI_LINE_COLUMNS);
    strncat(out, line, cap - strlen(out) - 1);
}
