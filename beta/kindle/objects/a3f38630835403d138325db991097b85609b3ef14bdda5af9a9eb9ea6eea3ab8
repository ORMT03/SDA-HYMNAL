            if(at<size&&(p[at]=='e'||p[at]=='E')){at++;if(at<size&&(p[at]=='+'||p[at]=='-'))at++;size_t start=at;while(at<size&&isdigit((unsigned char)p[at]))at++;if(at==start)j->error=1;}
            if(at!=size)j->error=1;
        }
    }
    t->end=(int)j->pos;t->next=j->used;return j->error ? -1 : n;
}
static int jparse(JSON *j, const void *s, size_t len) {
    memset(j,0,sizeof(*j));j->s=s;j->len=len;j->cap=100000;j->t=calloc((size_t)j->cap,sizeof(JT));
    if(!j->t)return -1;
    int n=jvalue(j,0);jspace(j);if(n<0||j->pos!=len){free(j->t);j->t=NULL;return -1;}return 0;
}
static int jeq(JSON *j,int n,const char *s) { return n>=0&&j->t[n].type=='"'&&j->t[n].end-j->t[n].start==(int)strlen(s)+2&&!memcmp(j->s+j->t[n].start+1,s,strlen(s)); }
static int jget(JSON *j,int n,const char *key) {
    if(n<0||j->t[n].type!='{')return -1;
    for(int k=n+1;k<j->t[n].next;){int v=k+1;if(jeq(j,k,key))return v;k=j->t[v].next;}return -1;
}
static unsigned jhex(const char *s) { unsigned n=0;for(int i=0;i<4;i++){unsigned char c=s[i];n=(n<<4)+(c<='9'?c-'0':(c|32)-'a'+10);}return n; }
